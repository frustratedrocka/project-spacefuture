{
  "postDataviewFilters": [
    {
      "name": "Redacted",
      "pattern": "!r!([\\s\\S]*?)!/r!",
      "replacement": "`REDACTED`",
      "flags": "g"
    },
    {
      "name": "Hidden",
      "pattern": "!h!([\\s\\S]*?)!/h!",
      "replacement": "",
      "flags": "g"
    },
    {
      "name": "Mech conditional",
      "pattern": "!mech!([\\s\\S]*?)!/mech!",
      "replacement": "",
      "flags": "g"
    }
  ],

  "id": "post-dataview-markers",
  "name": "Post-Dataview Filters",
  "version": "0.3.0",
  "description": "Applies regex replacements after Digital Garden has compiled Dataview output.",
  "author": "Ben Forde",
  "hooks": "index.js"
}
